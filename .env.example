# Скопируйте в .env и заполните.  Файл .env в git не попадает.
# Ключи можно сгенерировать так:  openssl rand -hex 32

# --- обязательное -----------------------------------------------------------
# my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Подпись cookie сессии. Смена — разлогинит всех.
SECRET_KEY=
# Шифрование файлов сессий и облачных паролей.
# ВНИМАНИЕ: смена этого ключа делает уже сохранённые сессии нечитаемыми.
ENCRYPTION_KEY=

# --- сеть -------------------------------------------------------------------
# 127.0.0.1 — за nginx на VPS; 0.0.0.0 — в контейнере (Railway, Docker).
HOST=127.0.0.1
PORT=8000
DOMAIN=localhost
# production включает Secure на cookie — обязателен HTTPS.
ENV=development

# --- хранение ---------------------------------------------------------------
# Относительные пути считаются от корня проекта, абсолютные берутся как есть.
# На Railway укажите путь внутри тома, например /data/recovery.db
DATABASE_PATH=./data/recovery.db
SESSIONS_DIR=./sessions
# BACKUPS_DIR=./data/backups

# --- поведение --------------------------------------------------------------
# 0 — не удалять коды автоматически.
AUTO_DELETE_CODES_DAYS=30
BACKUP_RETENTION_DAYS=30
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MIN=1
PENDING_AUTH_TTL=900

# Cookie сессии — сеансовая: закрыли браузер, значит вышли.
# SESSION_IDLE_TIMEOUT — простой без действий, после которого нужен новый вход
# (окно скользящее, каждый запрос его продлевает).
# SESSION_MAX_AGE — предельный срок от момента входа, дальше только новый вход.
SESSION_IDLE_TIMEOUT=1800
SESSION_MAX_AGE=28800

# Сколько доверенных прокси стоит перед приложением.
#   0 — приложение смотрит в интернет напрямую (X-Forwarded-For игнорируется);
#   1 — один nginx или edge Railway;
# Неверное значение позволяет обойти лимит попыток входа подменой заголовка.
TRUSTED_PROXY_HOPS=1

# Отдавать security-заголовки самим. Выключите (0), если их уже ставит nginx.
SEND_SECURITY_HEADERS=1
